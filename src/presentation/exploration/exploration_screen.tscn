theme_override_font_sizes/font_size = 17
text = "POKEDOT PLAYTEST\n\nExplore Mosslight Crossing and look for creatures in bright grass and mistferns. Face Ranger Mira and interact to read her field advice. Wild encounters currently open the tested battle-transition preview; press Enter, Space, or Escape to return to the field.\n\nMOVE        WASD or Arrow Keys\nINTERACT    E, Space, or Enter\nHELP        F1\nCONTRAST    F2\nTEXT SIZE   F3\nMOTION      F4\nMUTE        M\n\nAccessibility choices save automatically.\n\nPress Enter, Space, or Escape to begin."
vertical_alignment = 1
autowrap_mode = 2
