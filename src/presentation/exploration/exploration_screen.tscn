[node name="HelpText" type="Label" parent="Interface/HelpPanel/Margin/Scroll"]
custom_minimum_size = Vector2(600, 0)
theme_override_colors/font_color = Color(0.9, 0.95, 0.96, 1)
theme_override_font_sizes/font_size = 17
text = "POKEDOT PLAYTEST\n\nExplore Mosslight Crossing and look for creatures in bright grass and mistferns. Face Ranger Mira and interact to read her field advice. Wild encounters open a playable one-versus-one battle with original code-drawn creature graphics.\n\nFIELD\nMOVE        WASD or Arrow Keys\nINTERACT    E, Space, or Enter\nCREATURES   P — view every capture and choose the next fighter\n\nBATTLE\nMOVES       1–4 or click\nCAPTURE     C\nTONIC       I\nRUN         R or Escape\n\nHELP F1  ·  CONTRAST F2  ·  TEXT F3  ·  MOTION F4  ·  MUTE M\n\nAccessibility choices save automatically.\n\nPress Enter, Space, or Escape to begin."
vertical_alignment = 1
autowrap_mode = 2
