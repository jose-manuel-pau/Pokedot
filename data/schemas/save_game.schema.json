{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokedot.local/schemas/save_game.schema.json",
  "title": "Pokedot Save Game",
  "type": "object",
  "required": ["schema_version", "profile", "play_time_seconds", "exploration", "inventory", "collection"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "play_time_seconds": {"type": "integer", "minimum": 0},
    "exploration": {"$ref": "#/$defs/exploration"},
    "inventory": {"$ref": "#/$defs/inventory"},
    "collection": {"$ref": "#/$defs/collection"}
  },
  "additionalProperties": false,
  "$defs": {
    "contentId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "gridPosition": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "minItems": 2,
      "maxItems": 2
    },
    "stats": {
      "type": "object",
      "required": ["hp", "attack", "defense", "special_attack", "special_defense", "speed"],
      "properties": {
        "hp": {"type": "integer"},
        "attack": {"type": "integer"},
        "defense": {"type": "integer"},
        "special_attack": {"type": "integer"},
        "special_defense": {"type": "integer"},
        "speed": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["player_id", "player_name"],
      "properties": {
        "player_id": {"type": "string", "minLength": 1},
        "player_name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "exploration": {
      "type": "object",
      "required": ["map_id", "position", "facing"],
      "properties": {
        "map_id": {"$ref": "#/$defs/contentId"},
        "position": {"$ref": "#/$defs/gridPosition"},
        "facing": {"$ref": "#/$defs/gridPosition"}
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "required": ["max_slots", "quantities"],
      "properties": {
        "max_slots": {"type": "integer", "minimum": 1},
        "quantities": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "creature": {
      "type": "object",
      "required": [
        "instance_id", "species_id", "nickname", "level", "total_experience",
        "current_hp", "genetic_potential", "training", "aptitude_modifiers",
        "learned_move_ids", "persistent_status_ids"
      ],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "species_id": {"$ref": "#/$defs/contentId"},
        "nickname": {"type": "string"},
        "level": {"type": "integer", "minimum": 1, "maximum": 200},
        "total_experience": {"type": "integer", "minimum": 0},
        "current_hp": {"type": "integer", "minimum": 0},
        "genetic_potential": {"$ref": "#/$defs/stats"},
        "training": {"$ref": "#/$defs/stats"},
        "aptitude_modifiers": {"type": "object", "additionalProperties": {"type": "number"}},
        "learned_move_ids": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentId"}
        },
        "persistent_status_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contentId"}
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["party", "storage"],
      "properties": {
        "party": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/creature"}},
        "storage": {"type": "array", "items": {"$ref": "#/$defs/creature"}}
      },
      "additionalProperties": false
    }
  }
}
