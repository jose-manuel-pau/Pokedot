{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokedot.local/schemas/species.schema.json",
  "title": "Pokedot Species Content",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/species"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "stats": {
      "type": "object",
      "required": ["hp", "attack", "defense", "special_attack", "special_defense", "speed"],
      "properties": {
        "hp": {"type": "integer", "minimum": 1, "maximum": 255},
        "attack": {"type": "integer", "minimum": 1, "maximum": 255},
        "defense": {"type": "integer", "minimum": 1, "maximum": 255},
        "special_attack": {"type": "integer", "minimum": 1, "maximum": 255},
        "special_defense": {"type": "integer", "minimum": 1, "maximum": 255},
        "speed": {"type": "integer", "minimum": 1, "maximum": 255}
      },
      "additionalProperties": false
    },
    "learnsetEntry": {
      "type": "object",
      "required": ["level", "move_id"],
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 200},
        "move_id": {"$ref": "#/$defs/contentId"}
      },
      "additionalProperties": false
    },
    "species": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "description",
        "base_stats",
        "types",
        "catch_rate",
        "experience_yield",
        "growth_curve_id",
        "learnset"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/contentId"},
        "display_name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "base_stats": {"$ref": "#/$defs/stats"},
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentId"}
        },
        "catch_rate": {"type": "integer", "minimum": 1, "maximum": 255},
        "experience_yield": {"type": "integer", "minimum": 1, "maximum": 1000},
        "growth_curve_id": {"$ref": "#/$defs/contentId"},
        "learnset": {
          "type": "array",
          "items": {"$ref": "#/$defs/learnsetEntry"}
        }
      },
      "additionalProperties": false
    }
  }
}

